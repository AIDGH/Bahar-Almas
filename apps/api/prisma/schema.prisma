generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  INVALIDATED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  mobile       String        @unique @db.VarChar(16)
  displayName  String        @db.VarChar(40)
  bestScore    Int           @default(0)
  bestScoredAt DateTime?     @db.Timestamptz(3)
  sessions     UserSession[]
  gameSessions GameSession[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([bestScore, bestScoredAt])
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  mobile      String    @db.VarChar(16)
  displayName String?   @db.VarChar(40)
  codeHash    String    @db.Char(64)
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([mobile, createdAt])
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model GameSession {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  seed              Int
  startedAt         DateTime          @db.Timestamptz(3)
  expiresAt         DateTime          @db.Timestamptz(3)
  finishedAt        DateTime?         @db.Timestamptz(3)
  score             Int               @default(0)
  status            GameSessionStatus @default(ACTIVE)
  validationVersion Int               @default(1)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hits              GameHit[]
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, status])
  @@index([createdAt])
}

model GameHit {
  id              String      @id @default(uuid()) @db.Uuid
  gameSessionId   String      @db.Uuid
  targetId        Int
  hitAtMs         Int
  swipeDistance   Float
  swipeDurationMs Int
  points          Int
  gameSession     GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([gameSessionId, targetId])
  @@index([gameSessionId])
}
