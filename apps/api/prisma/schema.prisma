generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  INVALIDATED
}

enum AuthMode {
  LOGIN
  REGISTER
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                     String           @id @default(uuid()) @db.Uuid
  mobile                 String           @unique @db.VarChar(16)
  displayName            String           @db.VarChar(40)
  referralCode           String           @unique @db.VarChar(12)
  referredById           String?          @db.Uuid
  bestScore              Int              @default(0)
  bestScoredAt           DateTime?        @db.Timestamptz(3)
  totalGameScore         Int              @default(0)
  referralPoints         Int              @default(0)
  role                   UserRole         @default(USER)
  isBanned               Boolean          @default(false)
  bannedAt               DateTime?        @db.Timestamptz(3)
  sessions               UserSession[]
  gameSessions           GameSession[]
  referredBy             User?            @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]           @relation("UserReferrals")
  referralRewardsSent    ReferralReward[] @relation("ReferralRewardReferrer")
  referralRewardReceived ReferralReward?  @relation("ReferralRewardReferred")
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)

  @@index([bestScore, bestScoredAt])
  @@index([isBanned, bestScore, bestScoredAt])
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  mobile      String    @db.VarChar(16)
  displayName String?   @db.VarChar(40)
  authMode    AuthMode  @default(REGISTER)
  referrerId  String?   @db.Uuid
  codeHash    String    @db.Char(64)
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([mobile, createdAt])
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model GameSession {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String?           @db.Uuid
  claimTokenHash    String?           @unique @db.Char(64)
  claimExpiresAt    DateTime?         @db.Timestamptz(3)
  seed              Int
  startedAt         DateTime          @db.Timestamptz(3)
  expiresAt         DateTime          @db.Timestamptz(3)
  finishedAt        DateTime?         @db.Timestamptz(3)
  score             Int               @default(0)
  status            GameSessionStatus @default(ACTIVE)
  validationVersion Int               @default(1)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  hits              GameHit[]
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, status])
  @@index([createdAt])
}

model ReferralReward {
  id             String   @id @default(uuid()) @db.Uuid
  referrerId     String   @db.Uuid
  referredUserId String   @unique @db.Uuid
  points         Int      @default(1000)
  referrer       User     @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser   User     @relation("ReferralRewardReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([referrerId, createdAt])
}

model GameHit {
  id              String      @id @default(uuid()) @db.Uuid
  gameSessionId   String      @db.Uuid
  targetId        Int
  hitAtMs         Int
  swipeDistance   Float
  swipeDurationMs Int
  points          Int
  gameSession     GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([gameSessionId, targetId])
  @@index([gameSessionId])
}
